# RailVision-AI Configuration
# Copy this file to .env and modify values as needed

# Database
DATABASE_URL=postgresql+asyncpg://railvision:railvision@localhost:5432/railvision

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# OR-Tools
OR_TOOLS_TIME_LIMIT=30

# Emergency Response
EMERGENCY_RADIUS_KM=50.0
KAVACH_HALT_RADIUS_KM=50.0

# Health Score Thresholds
HEALTH_GREEN_THRESHOLD=0.8
HEALTH_ORANGE_THRESHOLD=0.6
HEALTH_RED_THRESHOLD=0.4
HEALTH_DARK_RED_THRESHOLD=0.2